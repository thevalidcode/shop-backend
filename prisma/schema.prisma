generator client {
  provider      = "prisma-client-js"
  output        = "./generated"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

/**
 * ============================
 * ENUMS
 * ============================
 */

enum ShopStatus {
  ACTIVE
  CANCELED
  DISABLED
  EXPIRED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum UserRole {
  BASIC
  VIP
  RESELLER
  PARTNER
}

enum AdminStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum AdminRole {
  SUPER
  BASIC
  MANAGER
  SUPPORT_STAFF
  FINANCE_OFFICER
  SERVICE_OPERATOR
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  VERIFYING_PAYMENT
  PROCESSING
  SHIPPED
  IN_TRANSIT
  DELIVERED
  FAILED_DELIVERY
  CANCELED
  REFUNDED
}

enum BlogStatus {
  ACTIVE
  DISABLED
}

enum FaqStatus {
  ACTIVE
  DISABLED
}

enum CategoryStatus {
  ACTIVE
  DISABLED
}

enum PageStatus {
  ACTIVE
  INACTIVE
}

enum PageType {
  PRODUCTS
  ORDERS
  ORDER
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  ABOUT_US
  CONTACT_US
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum AffiliateMode {
  PERCENTAGE
  FIXED
}

enum PaymentGatewayPlatform {
  MANUAL
  FLUTTERWAVE
  PAYSTACK
  CREDIT
}

enum PaymentGatewayStatus {
  ACTIVE
  DISABLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentPurpose {
  ORDER
  WALLET_TOPUP
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum TransactionType {
  ORDER_PAYMENT
  REFERRAL_CREDIT
  REFUND
  WALLET_CREDIT
  WALLET_DEBIT
  WALLET_REFUND
}

enum PaymentSource {
  DIRECT
  BALANCE
}

enum EmailStatus {
  SUCCESS
  ERROR
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MessageSenderType {
  USER
  ADMIN
}

enum ShippingPlatform {
  SENDBOX
  SHIPPO
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
  CANCELED
}

enum SupplierSourceType {
  EXTERNAL
  SYSTEM_INTERNAL
}

/**
 * ============================
 * MODELS
 * ============================
 */

model Shop {
  shopId      Int        @id @map("shop_id")
  uid         String     @unique // Shop domain e.g myshop.com
  ssl         Boolean    @default(false)
  timestamp   DateTime   @default(now())
  status      ShopStatus
  description String?
  name        String

  Admin            Admin[]
  AdminEmail       AdminEmail[]
  AffiliateSetting AffiliateSetting[]
  Blog             Blog[]
  ShippingInfo     ShippingInfo[]
  Cart             Cart[]
  Category         Category[]
  DesignStyle      DesignStyle[]
  EmailLog         EmailLog[]
  EmailTemplate    EmailTemplate[]
  Faq              Faq[]
  Order            Order[]
  Page             Page[]
  PaymentGateway   PaymentGateway[]
  Payment          Payment[]
  Product          Product[]
  SessionCode      SessionCode[]
  Setting          Setting[]
  shopCounter      ShopCounter?
  SupportTicket    SupportTicket[]
  Transaction      Transaction[]
  User             User[]
  uploadLogs       UploadLog[]
  ShippingAccount  ShippingAccount[]
  Shipment         Shipment[]
  suppliers        Supplier[]

  @@map("shops")
}

model ShopCounter {
  shopId                 Int @id @map("shop_id")
  productCounter         Int @default(0) @map("product_counter")
  orderCounter           Int @default(0) @map("order_counter")
  cartCounter            Int @default(0) @map("cart_counter")
  cartItemCounter        Int @default(0) @map("cart_item_counter")
  blogCounter            Int @default(0) @map("blog_counter")
  faqCounter             Int @default(0) @map("faq_counter")
  pageCounter            Int @default(0) @map("page_counter")
  categoryCounter        Int @default(0) @map("category_counter")
  userCounter            Int @default(0) @map("user_counter")
  emailLogCounter        Int @default(0) @map("email_log_counter")
  emailTemplateCounter   Int @default(0) @map("email_template_counter")
  paymentGatewayCounter  Int @default(0) @map("payment_gateway_counter")
  supportTicketCounter   Int @default(0) @map("support_ticket_counter")
  paymentCounter         Int @default(0) @map("payment_counter")
  transactionCounter     Int @default(0) @map("transaction_counter")
  uploadLogCounter       Int @default(0) @map("upload_log_counter")
  shippingInfoCounter    Int @default(0) @map("shipping_info_counter")
  shippingAccountCounter Int @default(0) @map("shipping_account_counter")
  shipmentCounter        Int @default(0) @map("shipment_counter")
  trackingEventCounter   Int @default(0) @map("tracking_event_counter")
  supplierCounter        Int @default(0) @map("supplier_counter")

  shop Shop @relation(fields: [shopId], references: [shopId], onDelete: Cascade)

  @@map("shop_counters")
}

model User {
  id               Int        @id @default(autoincrement())
  shopScopedId     Int        @map("shop_scoped_id")
  refCode          Int?       @unique @default(autoincrement()) @map("ref_code")
  uid              String     @unique
  email            String
  image            String?
  phone            String?
  password         String
  username         String
  encryptedApiKey  String?    @map("encrypted_api_key")
  apiKeyIv         String?    @map("api_key_iv")
  apiKeyHash       String?    @unique @map("api_key_hash")
  shopId           Int        @map("shop_id")
  balance          Decimal    @default(0.00) @db.Decimal(10, 2)
  spent            Decimal    @default(0.00) @db.Decimal(10, 2)
  timestamp        DateTime   @default(now())
  lastSeen         DateTime   @default(now()) @map("last_seen")
  currency         String     @default("USD")
  ref              Int?
  role             UserRole   @default(BASIC)
  status           UserStatus @default(ACTIVE)
  fullName         String?    @map("full_name")
  resetToken       String?    @map("reset_token")
  resetTokenExpiry DateTime?  @map("reset_token_expiry")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  ShippingInfo  ShippingInfo[]
  Order         Order[]
  Cart          Cart[]
  Payment       Payment[]
  SupportTicket SupportTicket[]
  transactions  Transaction[]
  reviews       ProductReview[]
  referredBy    User?           @relation("Referral", fields: [ref], references: [refCode])
  referrals     User[]          @relation("Referral")
  shop          Shop            @relation(fields: [shopId], references: [shopId], onDelete: Cascade)

  @@unique([shopId, shopScopedId])
  @@unique([email, shopId])
  @@unique([username, shopId])
  @@map("users")
}

// This Admin model is the user in the core-platform, that's why most fields aren't unique.
model Admin {
  id                  Int
  uid                 String
  email               String
  image               String?
  password            String
  username            String
  encryptedApiKey     String?     @map("encrypted_api_key")
  apiKeyIv            String?     @map("api_key_iv")
  apiKeyHash          String?     @unique @map("api_key_hash")
  shopId              Int         @unique @map("shop_id")
  timestamp           DateTime    @default(now())
  lastSeen            DateTime    @default(now()) @map("last_seen")
  role                AdminRole   @default(BASIC)
  status              AdminStatus @default(ACTIVE)
  fullName            String?     @map("full_name")
  onboardingCompleted Boolean?    @default(false) @map("onboarding_completed")
  resetToken          String?     @map("reset_token")
  resetTokenExpiry    DateTime?   @map("reset_token_expiry")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [shopId], onDelete: Cascade)

  @@map("admins")
}

model Product {
  id                 Int           @id @default(autoincrement())
  shopScopedId       Int           @map("shop_scoped_id")
  uid                String        @unique @default(uuid())
  name               String
  description        String?
  categoryUid        String?       @map("category_uid")
  min                Int           @default(1)
  max                Int           @default(100)
  position           Int           @default(1)
  status             ProductStatus @default(ACTIVE)
  currency           String        @default("USD")
  stock              Int           @default(0)
  sku                String?
  imageUrl           String?       @map("image_url")
  galleryUrls        String[]      @map("gallery_urls")
  tags               String[]
  isFeatured         Boolean       @default(false) @map("is_featured")
  brand              String?
  weight             Decimal?      @db.Decimal(10, 2)
  dimensions         String?
  price              Decimal       @default(0.00) @db.Decimal(10, 2)
  comparePrice       Decimal?      @map("compare_price") @db.Decimal(10, 2)
  supplierUid        String?       @map("supplier_uid")
  supplierPrice      Decimal?      @map("supplier_price") @db.Decimal(10, 2)
  supplierProductUid String?       @map("supplier_product_uid")
  supplierCurrency   String?       @map("supplier_currency")
  syncWithSupplier   Boolean       @default(true) @map("sync_with_supplier")
  syncQuantity       Boolean       @default(true) @map("sync_quantity")
  syncCatAndName     Boolean       @default(true) @map("sync_cat_and_name")
  marginType         String?       @default("percentage") @map("margin_type")
  marginValue        Decimal?      @default(0.00) @map("margin_value") @db.Decimal(10, 2)
  discountType       DiscountType? @map("discount_type")
  discountValue      Decimal?      @map("discount_value") @db.Decimal(10, 2)
  slug               String
  shopId             Int           @map("shop_id")

  // SEO fields
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description")
  metaKeywords    String[] @map("meta_keywords")

  // Advanced e-commerce features
  averageRating Decimal? @default(0) @map("average_rating") @db.Decimal(3, 2)
  totalReviews  Int      @default(0) @map("total_reviews")
  totalSales    Int      @default(0) @map("total_sales")
  viewCount     Int      @default(0) @map("view_count")

  // Inventory management
  lowStockThreshold Int?    @map("low_stock_threshold")
  trackInventory    Boolean @default(true) @map("track_inventory")
  allowBackorder    Boolean @default(false) @map("allow_backorder")

  // Product attributes
  color    String?
  size     String?
  material String?

  timestamp DateTime @default(now())
  updatedAt DateTime @updatedAt @map("updated_at")

  shop       Shop             @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  category   Category?        @relation(fields: [categoryUid], references: [uid], onDelete: SetNull)
  supplier   Supplier?        @relation(fields: [supplierUid], references: [uid], onDelete: SetNull)
  orderItems OrderItem[]
  cartItems  CartItem[]
  reviews    ProductReview[]
  images     ProductImage[]
  variants   ProductVariant[]

  @@unique([shopId, shopScopedId])
  @@unique([slug, shopId])
  @@unique([sku, shopId])
  @@map("products")
}

model ProductImage {
  id         Int      @id @default(autoincrement())
  uid        String   @unique @default(uuid())
  productUid String   @map("product_uid")
  imageUrl   String   @map("image_url")
  altText    String?  @map("alt_text")
  position   Int      @default(1)
  isPrimary  Boolean  @default(false) @map("is_primary")
  timestamp  DateTime @default(now())

  product Product @relation(fields: [productUid], references: [uid], onDelete: Cascade)

  @@map("product_images")
}

model ProductVariant {
  id           Int      @id @default(autoincrement())
  uid          String   @unique @default(uuid())
  productUid   String   @map("product_uid")
  name         String
  sku          String?  @unique
  price        Decimal  @db.Decimal(10, 2)
  comparePrice Decimal? @map("compare_price") @db.Decimal(10, 2)
  stock        Int      @default(0)
  imageUrl     String?  @map("image_url")

  // Variant attributes
  color    String?
  size     String?
  material String?
  weight   Decimal? @db.Decimal(10, 2)

  position  Int      @default(1)
  isDefault Boolean  @default(false) @map("is_default")
  timestamp DateTime @default(now())
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productUid], references: [uid], onDelete: Cascade)

  @@map("product_variants")
}

model ProductReview {
  id         Int          @id @default(autoincrement())
  uid        String       @unique @default(uuid())
  productUid String       @map("product_uid")
  userUid    String       @map("user_uid")
  rating     Int
  title      String?
  comment    String?
  isVerified Boolean      @default(false) @map("is_verified")
  status     ReviewStatus @default(PENDING)
  timestamp  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt @map("updated_at")

  product Product @relation(fields: [productUid], references: [uid], onDelete: Cascade)
  user    User    @relation(fields: [userUid], references: [uid], onDelete: Cascade)

  @@map("product_reviews")
}

model Order {
  id                   Int           @id @default(autoincrement())
  shopScopedId         Int           @map("shop_scoped_id")
  uid                  String        @unique @default(uuid())
  orderRef             String        @unique @map("order_ref")
  userUid              String        @map("user_uid")
  totalAmount          Decimal       @map("total_amount") @db.Decimal(10, 2)
  currency             String        @default("USD")
  status               OrderStatus   @default(PENDING)
  shippingInfoUid      String        @map("shipping_info_uid")
  paymentUid           String        @map("payment_uid")
  trackingNumber       String?       @map("tracking_number")
  estimatedDelivery    DateTime?     @map("estimated_delivery")
  deliveredAt          DateTime?     @map("delivered_at")
  notes                String?
  supplierUid          String?       @map("supplier_uid")
  supplierOrderUid     String?       @map("supplier_order_uid")
  supplierPrice        Decimal?      @map("supplier_price") @db.Decimal(10, 2)
  supplierCurrency     String?       @map("supplier_currency")
  syncWithSupplier     Boolean       @default(true) @map("sync_with_supplier")
  shippingCost         Decimal?      @map("shipping_cost") @db.Decimal(10, 2)
  shippingCurrency     String?       @map("shipping_currency")
  selectedShippingRate Json?         @map("selected_shipping_rate")
  userInitialBalance   Decimal       @default(0.00) @map("user_initial_balance") @db.Decimal(10, 2)
  userFinalBalance     Decimal       @default(0.00) @map("user_final_balance") @db.Decimal(10, 2)
  paidWithBalance      Boolean       @default(false) @map("paid_with_balance")
  paymentSource        PaymentSource @default(DIRECT) @map("payment_source")
  timestamp            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt @map("updated_at")
  shopId               Int           @map("shop_id")

  shop         Shop         @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  user         User         @relation(fields: [userUid], references: [uid], onDelete: Cascade)
  supplier     Supplier?    @relation(fields: [supplierUid], references: [uid], onDelete: SetNull)
  shippingInfo ShippingInfo @relation(fields: [shippingInfoUid], references: [uid], onDelete: Restrict)
  payment      Payment      @relation(fields: [paymentUid], references: [uid], onDelete: Cascade)
  items        OrderItem[]
  shipment     Shipment?

  @@unique([shopId, shopScopedId])
  @@map("orders")
}

model OrderItem {
  id                    Int     @id @default(autoincrement())
  uid                   String  @unique @default(uuid())
  orderId               Int     @map("order_id")
  productUid            String  @map("product_uid")
  quantity              Int
  priceAtTimeOfPurchase Decimal @map("price_at_time_of_purchase") @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productUid], references: [uid], onDelete: Restrict)

  @@map("order_items")
}

model Cart {
  id           Int    @id @default(autoincrement())
  shopScopedId Int    @map("shop_scoped_id")
  uid          String @unique @default(uuid())
  userUid      String @map("user_uid")
  shopId       Int    @map("shop_id")

  shop  Shop       @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  user  User       @relation(fields: [userUid], references: [uid], onDelete: Cascade)
  items CartItem[]

  @@unique([userUid, shopId])
  @@unique([shopId, shopScopedId])
  @@map("carts")
}

model CartItem {
  id           Int    @id @default(autoincrement())
  shopScopedId Int    @map("shop_scoped_id")
  uid          String @unique @default(uuid())
  cartId       Int    @map("cart_id")
  productId    Int    @map("product_id")
  quantity     Int

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("cart_items")
}

model ShippingInfo {
  id           Int      @id @default(autoincrement())
  shopScopedId Int      @map("shop_scoped_id")
  uid          String   @unique @default(uuid())
  userUid      String   @map("user_uid")
  shopId       Int      @map("shop_id")
  fullName     String   @map("full_name")
  email        String
  phone        String
  address      String
  city         String
  state        String
  postalCode   String   @map("postal_code")
  country      String
  isDefault    Boolean  @default(false) @map("is_default")
  timestamp    DateTime @default(now())
  updatedAt    DateTime @updatedAt @map("updated_at")

  user   User    @relation(fields: [userUid], references: [uid], onDelete: Cascade)
  shop   Shop    @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  orders Order[]

  @@unique([shopId, shopScopedId])
  @@map("shipping_info")
}

model Blog {
  id           Int        @id @default(autoincrement())
  shopScopedId Int        @map("shop_scoped_id")
  title        String
  content      String
  position     Int
  slug         String
  uid          String     @unique @default(uuid())
  shopId       Int        @map("shop_id")
  coverImage   String     @default("") @map("cover_image")
  status       BlogStatus @default(ACTIVE)
  excerpt      String
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  shop         Shop       @relation(fields: [shopId], references: [shopId], onDelete: Cascade)

  @@unique([shopId, shopScopedId])
  @@map("blogs")
}

model Category {
  id           Int            @id @default(autoincrement())
  shopScopedId Int            @map("shop_scoped_id")
  name         String
  timestamp    DateTime       @default(now())
  description  String         @default("")
  position     Int
  uid          String         @unique @default(uuid())
  shopId       Int            @map("shop_id")
  status       CategoryStatus @default(ACTIVE)
  iconUrl      String?        @map("icon_url")
  slug         String
  imageUrl     String?        @map("image_url")
  bannerUrl    String?        @map("banner_url")
  parentUid    String?        @map("parent_uid")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  shop     Shop      @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  products Product[]

  @@unique([shopId, shopScopedId])
  @@unique([slug, shopId])
  @@map("categories")
}

model Faq {
  id           Int       @id @default(autoincrement())
  shopScopedId Int       @map("shop_scoped_id")
  question     String
  answer       String
  position     Int
  slug         String
  uid          String    @unique @default(uuid())
  shopId       Int       @map("shop_id")
  timestamp    DateTime  @default(now())
  status       FaqStatus @default(ACTIVE)
  shop         Shop      @relation(fields: [shopId], references: [shopId], onDelete: Cascade)

  @@unique([shopId, shopScopedId])
  @@map("faqs")
}

model Page {
  id           Int        @id @default(autoincrement())
  shopScopedId Int        @map("shop_scoped_id")
  uid          String     @unique @default(uuid())
  title        String
  content      String
  description  String?
  pageType     PageType   @map("page_type")
  status       PageStatus @default(ACTIVE)
  shopId       Int        @map("shop_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  shop         Shop       @relation(fields: [shopId], references: [shopId], onDelete: Cascade)

  @@unique([shopId, shopScopedId])
  @@unique([shopId, pageType])
  @@map("pages")
}

model Setting {
  id                    Int      @id @default(autoincrement())
  uid                   String   @unique @default(uuid())
  shopId                Int      @unique @map("shop_id")
  shopName              String   @default("My Shop") @map("shop_name")
  shopDescription       String?  @map("shop_description")
  logoUrl               String?  @map("logo_url")
  faviconUrl            String?  @map("favicon_url")
  defaultClientCurrency String?  @map("default_client_currency")
  showBanner            Boolean? @default(true) @map("show_banner")
  onboardingCompleted   Boolean? @default(false) @map("onboarding_completed")

  // Social Accounts
  instagramUrl String?
  facebookUrl  String?
  youtubeUrl   String?
  xUrl         String?
  tiktokUrl    String?

  // Shop Physical Address (for shipping origin)
  shopStreet     String? @map("shop_street")
  shopCity       String? @map("shop_city")
  shopState      String? @map("shop_state")
  shopPostalCode String? @map("shop_postal_code")
  shopCountry    String? @map("shop_country")
  shopPhone      String? @map("shop_phone")

  shop Shop @relation(fields: [shopId], references: [shopId], onDelete: Cascade)

  @@map("settings")
}

model InternalApiSession {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  data      Json
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("internal_api_sessions")
}

model PaymentGateway {
  id                 Int                    @id @default(autoincrement())
  shopScopedId       Int                    @map("shop_scoped_id")
  uid                String                 @unique @default(uuid())
  name               String
  description        String?
  content            String?
  encryptedSecretKey String?                @map("encrypted_secret_key")
  iv                 String?
  createdAt          DateTime               @default(now()) @map("created_at")
  shopId             Int                    @map("shop_id")
  min                Decimal                @db.Decimal(10, 2)
  max                Decimal                @db.Decimal(10, 2)
  currency           String                 @default("USD")
  position           Int
  status             PaymentGatewayStatus   @default(ACTIVE)
  platform           PaymentGatewayPlatform @default(MANUAL)
  signature          String?
  webhookUrl         String?                @map("webhook_url")
  feePercent         Int?                   @default(0) @map("fee_percent")
  shop               Shop                   @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  payments           Payment[]

  @@unique([shopId, shopScopedId])
  @@map("payment_gateways")
}

model Supplier {
  id           Int       @id @default(autoincrement())
  shopScopedId Int       @map("shop_scoped_id")
  uid          String    @unique @default(uuid())
  name         String
  image        String?
  apiUrl       String    @map("api_url")
  apiKey       Json?     @map("api_key")
  percentage   Float     @default(0)
  sync         Boolean   @default(false)
  isInternal   Boolean   @default(false) @map("is_internal")
  shopId       Int       @map("shop_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  shop         Shop      @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  products     Product[]
  orders       Order[]

  @@unique([shopId, shopScopedId])
  @@unique([shopId, apiUrl])
  @@map("suppliers")
}

model SupportTicket {
  id           Int             @id @default(autoincrement())
  uid          String          @unique @default(uuid())
  shopId       Int             @map("shop_id")
  userUid      String          @map("user_uid")
  shopScopedId Int             @map("shop_scoped_id")
  subject      String
  status       TicketStatus    @default(OPEN)
  priority     TicketPriority  @default(MEDIUM)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  description  String?
  shop         Shop            @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  user         User            @relation(fields: [userUid], references: [uid], onDelete: Cascade)
  messages     TicketMessage[] @relation("TicketMessages")

  @@unique([shopId, shopScopedId])
  @@index([shopId])
  @@index([userUid])
  @@map("support_tickets")
}

model TicketMessage {
  id         Int               @id @default(autoincrement())
  uid        String            @unique @default(uuid())
  ticketUid  String            @map("ticket_uid")
  senderUid  String            @map("sender_uid")
  senderType MessageSenderType @map("sender_type")
  message    String
  createdAt  DateTime          @default(now()) @map("created_at")
  ticket     SupportTicket     @relation("TicketMessages", fields: [ticketUid], references: [uid], onDelete: Cascade)

  @@index([ticketUid])
  @@index([senderUid])
  @@map("ticket_messages")
}

model Transaction {
  id           Int               @id @default(autoincrement())
  shopScopedId Int               @map("shop_scoped_id")
  uid          String            @unique @default(uuid())
  amount       Decimal           @db.Decimal(10, 2)
  timestamp    DateTime          @default(now())
  currency     String            @default("USD")
  userUid      String            @map("user_uid")
  shopId       Int               @map("shop_id")
  status       TransactionStatus @default(PENDING)
  description  String
  type         TransactionType
  shop         Shop              @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  user         User              @relation(fields: [userUid], references: [uid], onDelete: Cascade)

  @@unique([shopId, shopScopedId])
  @@map("transactions")
}

model Payment {
  id                Int                    @id @default(autoincrement())
  uid               String                 @unique @default(uuid())
  userUid           String                 @map("user_id")
  currency          String
  amount            Decimal                @db.Decimal(10, 2)
  chargedAmount     Decimal                @map("charged_amount") @db.Decimal(10, 2)
  status            PaymentStatus          @default(PENDING)
  purpose           PaymentPurpose         @default(ORDER)
  method            PaymentGatewayPlatform
  paymentGatewayUid String                 @map("payment_gateway_uid")
  createdAt         DateTime               @default(now()) @map("created_at")
  shopId            Int                    @map("shop_id")
  shopScopedId      Int                    @map("shop_scoped_id")
  shop              Shop                   @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  user              User                   @relation(fields: [userUid], references: [uid], onDelete: Cascade)
  paymentGateway    PaymentGateway         @relation(fields: [paymentGatewayUid], references: [uid], onDelete: Restrict)
  orders            Order[]

  @@unique([shopId, shopScopedId])
  @@map("payments")
}

model EmailLog {
  id           Int         @id @default(autoincrement())
  shopScopedId Int         @map("shop_scoped_id")
  uid          String      @unique @default(uuid())
  sender       String
  receiver     String
  subject      String
  html         String
  status       EmailStatus
  messageId    String?     @map("message_id")
  response     String?
  shopId       Int         @map("shop_id")
  timestamp    DateTime    @default(now())
  shop         Shop        @relation(fields: [shopId], references: [shopId], onDelete: Cascade)

  @@unique([shopId, shopScopedId])
  @@map("email_logs")
}

model EmailTemplate {
  id           Int      @id @default(autoincrement())
  shopScopedId Int      @map("shop_scoped_id")
  uid          String   @unique @default(uuid())
  content      String // HTML template with {{variables}}
  name         String? // human-readable name
  shopId       Int      @map("shop_id")
  subject      String // optional default subject
  type         String // e.g., "PASSWORD_RESET", "WELCOME_USER", "ORDER_CONFIRMATION"
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  shop         Shop     @relation(fields: [shopId], references: [shopId], onDelete: Cascade)

  @@unique([shopId, shopScopedId])
  @@map("email_templates")
}

model AdminEmail {
  id        Int      @id @default(autoincrement())
  uid       String   @unique @default(uuid())
  emails    String[]
  shopId    Int      @unique @map("shop_id")
  timestamp DateTime @default(now())
  shop      Shop     @relation(fields: [shopId], references: [shopId], onDelete: Cascade)

  @@map("admins_emails")
}

model AffiliateSetting {
  id      Int           @id @default(autoincrement())
  uid     String        @unique @default(uuid())
  percent Int
  mode    AffiliateMode @default(PERCENTAGE)
  shopId  Int           @unique @map("shop_id")
  shop    Shop          @relation(fields: [shopId], references: [shopId], onDelete: Cascade)

  @@map("affiliate_settings")
}

model DesignStyle {
  id           Int     @id @default(autoincrement())
  shopScopedId Int     @map("shop_scoped_id")
  uid          String  @unique @default(uuid())
  shopId       Int     @map("shop_id")
  hex          String
  schema       Json
  name         String?
  shop         Shop    @relation(fields: [shopId], references: [shopId], onDelete: Cascade)

  @@unique([shopId, shopScopedId])
  @@map("design_styles")
}

model SessionCode {
  code      String   @id
  email     String
  shopId    Int      @map("shop_id")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  shop      Shop     @relation(fields: [shopId], references: [shopId], onDelete: Cascade)

  @@map("session_codes")
}

model ExchangeRate {
  id          Int      @id @default(autoincrement())
  rates       Json
  lastUpdated DateTime @default(now()) @map("last_updated")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("exchange_rates")
}

model UploadLog {
  id           Int      @id @default(autoincrement())
  shopScopedId Int      @map("shop_scoped_id")
  uid          String   @unique @default(uuid())
  size         Int
  url          String
  collection   String
  filename     String
  mimetype     String
  shopId       Int      @map("shop_id")
  timestamp    DateTime @default(now())
  shop         Shop     @relation(fields: [shopId], references: [shopId], onDelete: Cascade)

  @@unique([shopId, shopScopedId])
  @@map("upload_logs")
}

model ShippingAccount {
  id              Int              @id @default(autoincrement())
  shopScopedId    Int              @map("shop_scoped_id")
  uid             String           @unique @default(uuid())
  shopId          Int              @map("shop_id")
  platform        ShippingPlatform
  encryptedApiKey String           @map("encrypted_api_key")
  iv              String
  isActive        Boolean          @default(true) @map("is_active")
  isPreferred     Boolean          @default(false) @map("is_preferred")
  testMode        Boolean          @default(true) @map("test_mode")
  lastTestedAt    DateTime?        @map("last_tested_at")
  lastTestStatus  String?          @map("last_test_status")
  webhookSecret   String?          @map("webhook_secret")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  shop            Shop             @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  shipments       Shipment[]

  @@unique([shopId, platform])
  @@unique([shopId, shopScopedId])
  @@map("shipping_accounts")
}

model Shipment {
  id                    Int              @id @default(autoincrement())
  shopScopedId          Int              @map("shop_scoped_id")
  uid                   String           @unique @default(uuid())
  orderUid              String           @unique @map("order_uid")
  shopId                Int              @map("shop_id")
  shippingAccountUid    String           @map("shipping_account_uid")
  platform              ShippingPlatform
  externalShipmentId    String?          @map("external_shipment_id")
  courierName           String?          @map("courier_name")
  courierCode           String?          @map("courier_code")
  trackingNumber        String?          @unique @map("tracking_number")
  trackingUrl           String?          @map("tracking_url")
  labelUrl              String?          @map("label_url")
  status                ShipmentStatus   @default(PENDING)
  estimatedDeliveryDate DateTime?        @map("estimated_delivery_date")
  actualDeliveryDate    DateTime?        @map("actual_delivery_date")
  weight                Decimal?         @db.Decimal(10, 2)
  weightUnit            String?          @map("weight_unit")
  shippingCost          Decimal?         @map("shipping_cost") @db.Decimal(10, 2)
  currency              String?

  // Generic provider fields
  baseFee      Decimal? @map("base_fee") @db.Decimal(10, 2)
  taxAmount    Decimal? @map("tax_amount") @db.Decimal(10, 2)
  insuranceFee Decimal? @map("insurance_fee") @db.Decimal(10, 2)

  lastSyncedAt    DateTime?       @map("last_synced_at")
  metadata        Json? // Provider-specific data
  rawResponse     Json?           @map("raw_response") // Full API response
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  shop            Shop            @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  order           Order           @relation(fields: [orderUid], references: [uid], onDelete: Cascade)
  shippingAccount ShippingAccount @relation(fields: [shippingAccountUid], references: [uid], onDelete: Restrict)
  trackingEvents  TrackingEvent[]

  @@unique([shopId, shopScopedId])
  @@index([trackingNumber])
  @@index([orderUid])
  @@map("shipments")
}

model TrackingEvent {
  id            Int      @id @default(autoincrement())
  shopScopedId  Int      @map("shop_scoped_id")
  uid           String   @unique @default(uuid())
  shipmentUid   String   @map("shipment_uid")
  shopId        Int      @map("shop_id")
  status        String
  statusCode    String?  @map("status_code")
  location      String?
  description   String?
  courierStatus String?  @map("courier_status")
  timestamp     DateTime
  rawPayload    Json?    @map("raw_payload")
  createdAt     DateTime @default(now()) @map("created_at")
  shipment      Shipment @relation(fields: [shipmentUid], references: [uid], onDelete: Cascade)

  @@index([shipmentUid])
  @@map("tracking_events")
}
