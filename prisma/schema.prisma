generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shop {
  shopId    Int      @id @map("shop_id")
  uid       String   @unique
  ssl       Boolean  @default(false)
  plan      String   @default("starter")
  status    String   @default("active")
  timestamp DateTime @default(now())

  User             User[]
  Admin            Admin[]
  Product          Product[]
  Order            Order[]
  AdminEmail       AdminEmail[]
  AffiliateSetting AffiliateSetting[]
  Blog             Blog[]
  Category         Category[]
  DesignStyle      DesignStyle[]
  EmailLog         EmailLog[]
  EmailTemplate    EmailTemplate[]
  Faq              Faq[]
  General          General[]
  SessionCode      SessionCode[]

  shopCounter ShopCounter?

  ContactMessage    ContactMessage[]
  PaymentGateway    PaymentGateway[]
  WalletTransaction WalletTransaction[]

  @@map("shops")
}

model ShopCounter {
  shopId Int @id @map("shop_id")

  productCounter  Int @default(0) @map("product_counter")
  orderCounter    Int @default(0) @map("order_counter")
  blogCounter     Int @default(0) @map("blog_counter")
  faqCounter      Int @default(0) @map("faq_counter")
  categoryCounter Int @default(0) @map("category_counter")
  userCounter     Int @default(0) @map("user_counter")
  emailLogCounter Int @default(0) @map("email_log_counter")

  shop Shop @relation(fields: [shopId], references: [shopId], onDelete: Cascade)

  @@map("shop_counters")
}

model User {
  id           Int      @id @default(autoincrement())
  shopScopedId Int // The per-shop sequential ID
  refCode      Int?     @unique @default(autoincrement()) @map("ref_code")
  uid          String   @unique
  email        String
  image        String?
  password     String
  username     String
  apiKey       String   @unique @map("api_key")
  role         String   @default("user")
  status       String   @default("active")
  shopId       Int      @map("shop_id")
  shop         Shop     @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  balance      Decimal  @default(0.00) @db.Decimal(10, 2)
  spent        Decimal  @default(0.00) @db.Decimal(10, 2)
  timestamp    DateTime @default(now())
  lastSeen     DateTime @default(now()) @map("last_seen")
  currency     String   @default("USD")

  ref        Int?
  referredBy User?  @relation("Referral", fields: [ref], references: [refCode], onDelete: SetNull)
  referrals  User[] @relation("Referral")

  cart Cart?

  transactions WalletTransaction[]

  @@unique([shopId, shopScopedId])
  @@unique([email, shopId])
  @@unique([username, shopId])
  @@map("users")
}

model Admin {
  id        Int      @id @default(autoincrement())
  uid       String   @unique
  email     String
  image     String?
  password  String
  username  String
  apiKey    String   @unique @map("api_key")
  role      String   @default("admin")
  status    String   @default("active")
  shopId    Int      @map("shop_id")
  shop      Shop     @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  timestamp DateTime @default(now())
  lastSeen  DateTime @default(now()) @map("last_seen")

  @@unique([email, shopId])
  @@map("admins")
}

model Product {
  id            Int      @id @default(autoincrement()) @map("id")
  shopScopedId  Int      @map("shop_scoped_id")
  uid           String   @unique
  name          String
  description   String?
  category      String
  type          String
  min           Int      @default(1)
  max           Int      @default(1)
  position      Int      @default(0)
  status        String   @default("active")
  stock         Int      @default(0)
  sku           String?
  imageUrl      String?  @map("image_url")
  galleryUrls   String[] @map("gallery_urls")
  tags          String[]
  isFeatured    Boolean  @default(false) @map("is_featured")
  brand         String?
  weight        Decimal?
  dimensions    String?
  price         Decimal  @default(0.00)
  comparePrice  Decimal? @map("compare_price")
  discountType  String?  @map("discount_type")
  discountValue Decimal? @map("discount_value")
  slug          String
  shopId        Int      @map("shop_id")
  timestamp     DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [shopId], onDelete: Cascade)

  cartItems CartItem[]

  orderItems OrderItem[]

  @@unique([shopId, shopScopedId])
  @@unique([slug, shopId])
  @@map("products")
}

model Order {
  id                Int       @id @default(autoincrement()) @map("id")
  shopScopedId      Int       @map("shop_scoped_id")
  uid               String    @unique
  orderRef          String    @unique @map("order_ref") // Customer-facing unique reference
  userUid           String    @map("user_uid")
  totalAmount       Decimal   @map("total_amount") @db.Decimal(10, 2)
  currency          String    @default("USD")
  status            String    @default("Pending") // Pending -> Processing -> Shipped -> Delivered
  shippingAddress   String    @map("shipping_address")
  billingAddress    String    @map("billing_address")
  paymentMethod     String    @map("payment_method")
  paymentReference  String?   @map("payment_reference")
  trackingNumber    String?   @map("tracking_number")
  estimatedDelivery DateTime? @map("estimated_delivery")
  deliveredAt       DateTime? @map("delivered_at")
  timestamp         DateTime  @default(now())
  shopId            Int       @map("shop_id")

  shop  Shop        @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  items OrderItem[] // Relation to multiple order items

  @@unique([shopId, shopScopedId])
  @@map("orders")
}

model OrderItem {
  id                    Int     @id @default(autoincrement())
  orderId               Int     @map("order_id")
  productId             Int     @map("product_id")
  quantity              Int
  priceAtTimeOfPurchase Decimal @map("price_at_time_of_purchase") @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

model Blog {
  id           Int      @id @default(autoincrement()) @map("id")
  shopScopedId Int      @map("shop_scoped_id")
  title        String
  content      String
  description  String   @default("")
  status       String   @default("active")
  position     Int
  slug         String
  uid          String   @unique
  shopId       Int      @map("shop_id")
  shop         Shop     @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  timestamp    DateTime @default(now())

  @@unique([shopId, shopScopedId])
  @@unique([slug, shopId])
  @@map("blogs")
}

model Category {
  id           Int      @id @default(autoincrement()) @map("id")
  shopScopedId Int      @map("shop_scoped_id")
  uid          String   @unique
  name         String
  slug         String
  description  String   @default("")
  imageUrl     String?  @map("image_url")
  bannerUrl    String?  @map("banner_url")
  iconUrl      String?  @map("icon_url")
  status       String   @default("active")
  position     Int      @default(1)
  parentUid    String?  @map("parent_uid")
  shopId       Int      @map("shop_id")
  shop         Shop     @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  timestamp    DateTime @default(now())

  @@unique([shopId, shopScopedId])
  @@unique([slug, shopId])
  @@map("categories")
}

model Faq {
  id           Int      @id @default(autoincrement()) @map("id")
  shopScopedId Int      @map("shop_scoped_id")
  question     String
  answer       String
  status       String   @default("active")
  position     Int
  slug         String
  uid          String   @unique
  shopId       Int      @map("shop_id")
  shop         Shop     @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  timestamp    DateTime @default(now())

  @@unique([shopId, shopScopedId])
  @@unique([slug, shopId])
  @@map("faqs")
}

model EmailLog {
  id           Int      @id @default(autoincrement()) @map("id")
  shopScopedId Int      @map("shop_scoped_id")
  uid          String   @unique
  sender       String
  receiver     String
  subject      String
  html         String
  status       String
  messageId    String?  @map("message_id")
  response     String?
  shopId       Int      @map("shop_id")
  shop         Shop     @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  timestamp    DateTime @default(now())

  @@unique([shopId, shopScopedId])
  @@map("email_logs")
}

model AdminEmail {
  id        Int      @id @default(autoincrement())
  uid       String   @unique
  emails    String[]
  shopId    Int      @map("shop_id")
  shop      Shop     @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  timestamp DateTime @default(now())

  @@map("admins_emails")
}

model AffiliateSetting {
  id      Int    @id @default(autoincrement()) @map("id")
  uid     String @unique
  percent Int
  mode    String @default("percentage")
  shopId  Int    @map("shop_id")
  shop    Shop   @relation(fields: [shopId], references: [shopId], onDelete: Cascade)

  @@unique([shopId])
  @@map("affiliate_settings")
}

model Currency {
  id        Int      @id @default(autoincrement())
  uid       String   @unique
  timestamp DateTime @default(now())
  quotes    Json

  @@map("currencies")
}

model DesignStyle {
  id     Int    @id @default(autoincrement()) @map("id")
  uid    String @unique
  shopId Int    @map("shop_id")
  shop   Shop   @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  title  String
  hex    String
  schema Json

  @@unique([shopId])
  @@map("design_styles")
}

model EmailTemplate {
  id        Int      @id @default(autoincrement()) @map("id")
  uid       String   @unique
  type      String
  content   String
  shopId    Int      @map("shop_id")
  shop      Shop     @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  timestamp DateTime @default(now())

  @@unique([type, shopId])
  @@map("email_templates")
}

model General {
  id                    Int     @id @default(autoincrement()) @map("id")
  uid                   String  @unique
  shopId                Int     @map("shop_id")
  shop                  Shop    @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  title                 String  @default("Shop")
  logoUrl               String? @map("logo_url")
  faviconUrl            String? @map("favicon_url")
  defaultClientCurrency String? @map("default_client_currency")

  @@unique([shopId])
  @@map("general")
}

model SessionCode {
  code      String   @id
  email     String
  shopId    Int      @map("shop_id")
  shop      Shop     @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)

  @@map("session_codes")
}

model Cart {
  id        Int      @id @default(autoincrement())
  uid       String   @unique @default(uuid())
  shopId    Int      @map("shop_id")
  userUid   String   @unique @map("user_uid") // One cart per user
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User       @relation(fields: [userUid], references: [uid], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        Int @id @default(autoincrement())
  cartId    Int @map("cart_id")
  productId Int @map("product_id")
  quantity  Int

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId]) // Ensure a product appears only once per cart
  @@map("cart_items")
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  uid       String   @unique @default(uuid())
  shopId    Int      @map("shop_id")
  name      String
  email     String
  phone     String?
  message   String
  status    String   @default("new") // "new", "read", "archived"
  timestamp DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [shopId], onDelete: Cascade)

  @@map("contact_messages")
}

model PaymentGateway {
  id                 Int     @id @default(autoincrement())
  uid                String  @unique @default(uuid())
  shopId             Int     @map("shop_id")
  name               String // "paystack", "flutterwave", etc.
  publicKey          String  @map("public_key")
  encryptedSecretKey String  @map("encrypted_secret_key")
  iv                 String // Initialization Vector for decryption
  isActive           Boolean @default(false) @map("is_active")

  shop Shop @relation(fields: [shopId], references: [shopId], onDelete: Cascade)

  @@unique([shopId, name])
  @@map("payment_gateways")
}

model WalletTransaction {
  id          Int      @id @default(autoincrement())
  uid         String   @unique @default(uuid())
  userUid     String   @map("user_uid")
  shopId      Int      @map("shop_id")
  amount      Decimal  @db.Decimal(10, 2)
  type        String // "credit" or "debit"
  description String
  timestamp   DateTime @default(now())

  user User @relation(fields: [userUid], references: [uid], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [shopId], onDelete: Cascade)

  @@map("wallet_transactions")
}

model InternalApiSession {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  data      Json
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("internal_api_sessions")
}