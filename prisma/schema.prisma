generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shop {
  shopId    Int      @id @map("shop_id")
  uid       String   @unique
  ssl       Boolean  @default(false)
  plan      String   @default("starter")
  status    String   @default("active")
  timestamp DateTime @default(now())

  User             User[]
  Admin            Admin[]
  Product          Product[]
  Order            Order[]
  AdminEmail       AdminEmail[]
  AffiliateSetting AffiliateSetting[]
  Blog             Blog[]
  Category         Category[]
  DesignStyle      DesignStyle[]
  EmailLog         EmailLog[]
  EmailTemplate    EmailTemplate[]
  Faq              Faq[]
  General          General[]
  SessionCode      SessionCode[]
  
  // Relation to the new counter table
  StoreCounter     StoreCounter?

  @@map("shops")
}

model StoreCounter {
  shopId Int @id

  // Add a counter for each model that needs a per-shop sequential ID
  productCounter  Int @default(0)
  orderCounter    Int @default(0)
  blogCounter     Int @default(0)
  faqCounter      Int @default(0)
  categoryCounter Int @default(0)
  userCounter     Int @default(0)
  emailLogCounter Int @default(0)

  shop Shop @relation(fields: [shopId], references: [shopId], onDelete: Cascade)

  @@map("store_counters")
}


model User {
  id         Int      @id @default(autoincrement())
  shopScopedId Int    // The per-shop sequential ID
  refCode    Int?     @unique @default(autoincrement()) @map("ref_code")
  uid        String   @unique
  email      String
  image      String?
  password   String
  username   String
  apiKey     String   @unique @map("api_key")
  role       String   @default("user")
  status     String   @default("active")
  shopId     Int      @map("shop_id")
  shop       Shop     @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  balance    Decimal  @default(0.00) @db.Decimal(10, 2)
  spent      Decimal  @default(0.00) @db.Decimal(10, 2)
  timestamp  DateTime @default(now())
  lastSeen   DateTime @default(now()) @map("last_seen")
  currency   String   @default("USD")
  
  ref        Int?
  referredBy User?    @relation("Referral", fields: [ref], references: [refCode], onDelete: SetNull)
  referrals  User[]   @relation("Referral") 

  @@unique([shopId, shopScopedId])
  @@unique([email, shopId])
  @@unique([username, shopId])
  @@map("users")
}

model Admin {
  id        Int      @id @default(autoincrement())
  uid       String   @unique
  email     String
  image     String?
  password  String
  username  String
  apiKey    String   @unique @map("api_key")
  role      String   @default("admin")
  status    String   @default("active")
  shopId    Int      @map("shop_id")
  shop      Shop     @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  timestamp DateTime @default(now())
  lastSeen  DateTime @default(now()) @map("last_seen")

  @@unique([email, shopId])
  @@map("admins")
}

model Product {
  id             Int       @id @default(autoincrement()) @map("id")
  shopScopedId   Int       // The per-shop sequential ID
  uid            String    @unique
  name           String
  description    String?
  category       String
  type           String
  min            Int       @default(1)
  max            Int       @default(1)
  position       Int       @default(0)
  status         String    @default("active")
  stock          Int       @default(0)
  sku            String?
  imageUrl       String?   @map("image_url")
  galleryUrls    String[]  @map("gallery_urls")
  tags           String[]
  isFeatured     Boolean   @default(false) @map("is_featured")
  brand          String?
  weight         Decimal?  
  dimensions     String?
  price          Decimal   @default(0.00)
  comparePrice   Decimal?  @map("compare_price")
  discountType   String?   @map("discount_type")
  discountValue  Decimal?  @map("discount_value")
  slug           String
  shopId         Int       @map("shop_id")
  timestamp      DateTime  @default(now())

  shop           Shop      @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  
  @@unique([shopId, shopScopedId])
  @@unique([slug, shopId])
  @@map("products")
}

model Order {
  id                 Int       @id @default(autoincrement()) @map("id")
  shopScopedId       Int       // The per-shop sequential ID
  uid                String    @unique
  userUid            String    @map("user_uid")
  productId          Int       @map("product_id")
  price              Decimal   @default(0)
  quantity           Int
  currency           String    @default("USD")
  status             String    @default("Pending")
  shippingAddress    String    @map("shipping_address")
  billingAddress     String    @map("billing_address")
  paymentMethod      String    @map("payment_method")
  trackingNumber     String?   @map("tracking_number")
  estimatedDelivery  DateTime? @map("estimated_delivery")
  deliveredAt        DateTime? @map("delivered_at")
  timestamp          DateTime  @default(now())
  shopId             Int       @map("shop_id")
  shop               Shop      @relation(fields: [shopId], references: [shopId], onDelete: Cascade)

  @@unique([shopId, shopScopedId])
  @@map("orders")
}

model Blog {
  id          Int      @id @default(autoincrement()) @map("id")
  shopScopedId Int     // The per-shop sequential ID
  title       String
  content     String
  description String   @default("")
  status      String   @default("active")
  position    Int
  slug        String
  uid         String   @unique
  shopId      Int      @map("shop_id")
  shop        Shop     @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  timestamp   DateTime @default(now())
  
  @@unique([shopId, shopScopedId])
  @@unique([slug, shopId])
  @@map("blogs")
}

model Category {
  id          Int      @id @default(autoincrement()) @map("id")
  shopScopedId Int     // The per-shop sequential ID
  uid         String   @unique
  name        String
  slug        String
  description String   @default("")
  imageUrl    String?  @map("image_url")
  bannerUrl   String?  @map("banner_url")
  iconUrl     String?  @map("icon_url")
  status      String   @default("active")
  position    Int      @default(1)
  parentUid   String?  @map("parent_uid")
  shopId      Int      @map("shop_id")
  shop        Shop     @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  timestamp   DateTime @default(now())

  @@unique([shopId, shopScopedId])
  @@unique([slug, shopId])
  @@map("categories")
}

model Faq {
  id        Int      @id @default(autoincrement()) @map("id")
  shopScopedId Int   // The per-shop sequential ID
  question  String
  answer    String
  status    String   @default("active")
  position  Int
  slug      String
  uid       String   @unique
  shopId    Int      @map("shop_id")
  shop      Shop     @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  timestamp DateTime @default(now())
  
  @@unique([shopId, shopScopedId])
  @@unique([slug, shopId])
  @@map("faqs")
}

model EmailLog {
  id        Int      @id @default(autoincrement()) @map("id")
  shopScopedId Int   // The per-shop sequential ID
  uid       String   @unique
  sender    String
  receiver  String
  subject   String
  html      String
  status    String
  messageId String?  @map("message_id")
  response  String?
  shopId    Int      @map("shop_id")
  shop      Shop     @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  timestamp DateTime @default(now())
  
  @@unique([shopId, shopScopedId])
  @@map("email_logs")
}

model AdminEmail {
  id        Int      @id @default(autoincrement())
  uid       String   @unique
  emails    String[]
  shopId    Int      @map("shop_id")
  shop      Shop     @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  timestamp DateTime @default(now())

  @@map("admins_emails")
}

model AffiliateSetting {
  id      Int    @id @default(autoincrement()) @map("id")
  uid     String @unique
  percent Int
  mode    String @default("percentage")
  shopId  Int    @map("shop_id")
  shop    Shop   @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  
  @@unique([shopId])
  @@map("affiliate_settings")
}

model Currency {
  id        Int      @id @default(autoincrement())
  uid       String   @unique
  timestamp DateTime @default(now())
  quotes    Json

  @@map("currencies")
}

model DesignStyle {
  id     Int    @id @default(autoincrement()) @map("id")
  uid    String @unique
  shopId Int    @map("shop_id")
  shop   Shop   @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  title  String
  hex    String
  schema Json
  
  @@unique([shopId])
  @@map("design_styles")
}

model EmailTemplate {
  id        Int      @id @default(autoincrement()) @map("id")
  uid       String   @unique
  type      String
  content   String
  shopId    Int      @map("shop_id")
  shop      Shop     @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  timestamp DateTime @default(now())
  
  @@unique([type, shopId])
  @@map("email_templates")
}

model General {
  id                    Int     @id @default(autoincrement()) @map("id")
  uid                   String  @unique
  shopId                Int     @map("shop_id")
  shop                  Shop    @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  title                 String  @default("Shop")
  logoUrl               String? @map("logo_url")
  faviconUrl            String? @map("favicon_url")
  defaultClientCurrency String? @map("default_client_currency")

  @@unique([shopId])
  @@map("general")
}

model SessionCode {
  code      String   @id
  email     String
  shopId    Int      @map("shop_id")
  shop      Shop     @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)

  @@map("session_codes")
}