model Faq {
  id        Int      @map("id")
  question  String
  answer    String
  status    String   @default("active")
  position  Int
  slug      String
  uid       String   @id
  shopId    Int      @map("shop_id")
  shop      Shop     @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  timestamp DateTime @default(now())

  @@map("faqs")
}
