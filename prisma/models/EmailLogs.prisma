model EmailLog {
  id        Int      @map("id")
  uid       String   @id
  sender    String
  receiver  String
  subject   String
  html      String
  status    String
  messageId String?  @map("message_id")
  response  String?
  shopId    Int      @map("shop_id")
  shop      Shop     @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  timestamp DateTime @default(now())

  @@map("email_logs")
}