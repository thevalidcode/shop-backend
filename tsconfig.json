{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2020"],
    "rootDir": "src",
    "outDir": "app",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": false,
    "declaration": true,
    "allowSyntheticDefaultImports": true,
  },
  "include": ["src", "prisma"],
  "exclude": ["node_modules", "app"]
}
